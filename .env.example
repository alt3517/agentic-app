AI_JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-bytes-long
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-luna
OPENAI_TICKET_CONTEXT_ENABLED=false
OPENAI_KNOWLEDGE_CONTEXT_ENABLED=false
WEB_SEARCH_ENABLED=false
RERANKING_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
AGENTIC_APP_PUBLIC_URL=https://localhost:8000
CORS_ALLOWED_ORIGINS=https://localhost:7161
DEMO_ADMIN_EMAIL=admin@local.test
DEMO_ADMIN_PASSWORD=replace-with-a-unique-password-of-12-or-more-characters
DEMO_AGENT_EMAIL=agent@local.test
DEMO_AGENT_PASSWORD=replace-with-a-different-unique-password-of-12-or-more-characters
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-grafana-admin-password

NGROK_AUTHTOKEN=<token ngrok>
NGROK_GRAFANA_DOMAIN=<dominio-ngrok-riservato, senza https://>
GRAFANA_ROOT_URL=https://<lo-stesso-dominio>/
