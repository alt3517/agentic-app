@model TicketInput
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
    <div class="col-12 col-md-8">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-4">
        <label asp-for="Category" class="form-label"></label>
        <input asp-for="Category" class="form-control" />
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="6"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    @if (User.IsInRole("Agent") || User.IsInRole("Admin"))
    {
        <div class="col-12 col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<TicketStatus>()"></select>
        </div>
        <div class="col-12 col-md-4">
            <label asp-for="Priority" class="form-label"></label>
            <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<TicketPriority>()"></select>
        </div>
        <div class="col-12 col-md-4">
            <label asp-for="AssignedToId" class="form-label">Assigned to</label>
            <select asp-for="AssignedToId" class="form-select" asp-items="ViewBag.Assignees">
                <option value="">Unassigned</option>
            </select>
        </div>
    }
</div>
