@model TicketInput
@{
    ViewData["Title"] = "Create ticket";
}

<section class="ticket-form-card">
    <div class="page-intro">
        <span class="eyebrow">New request</span>
        <h1>Create a ticket</h1>
        <p class="page-subtitle">Tell us what you need help with. You can follow updates from your tickets.</p>
    </div>
    <form asp-action="Create" method="post">
        <partial name="_TicketForm" model="Model" />
        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Submit ticket</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
